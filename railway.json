{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "buildroom/connector/Dockerfile",
    "watchPatterns": ["buildroom/connector/**", "buildroom/skills/**", "buildroom/rollout/releases/README.md"]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
